# Copy this file to .env and fill in your own Supabase project values.
# Find these in Supabase Dashboard -> Project Settings -> API.
# These are the ONLY two env vars the app code actually reads
# (src/lib/supabase.js) - the rest that used to live in .env
# (OpenAI/Gemini/Anthropic/Stripe/Analytics keys) were unused and removed.

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here
